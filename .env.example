# Baaki environment — copy to `.env` and fill in.

# Supabase Postgres connection strings (Dashboard → Connect → ORM / Prisma):
#   DATABASE_URL = Transaction pooler, port 6543, MUST end with ?pgbouncer=true
#   DIRECT_URL   = Session pooler / direct connection, port 5432 (used by db push)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secret used to sign session tokens (JWT). Use a long random string (32+ chars).
AUTH_SECRET="change-me-to-a-long-random-string"

# Email delivery for password resets (optional). Without RESEND_API_KEY, reset
# links are logged to the server console instead of emailed. Get a key at
# resend.com; EMAIL_FROM must be an address on a domain you've verified there.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Baaki <no-reply@yourdomain.com>"
